def compute_factorial():
    """Computes the factorial of a non-negative integer entered by the user."""

    while True:  # Input loop for validation
        try:
            num_str = input("Enter a non-negative integer: ")
            num = int(num_str)  # Attempt to convert to integer

            if num < 0:
                print("Error: Factorial is not defined for negative numbers.")
                continue  # Go back to the beginning of the loop

            break  # Exit the loop if input is valid

        except ValueError:  # Handle non-integer input
            print("Error: Invalid input. Please enter an integer.")


    if num == 0:
        factorial = 1  # Special case: 0! = 1
    else:
        factorial = 1
        for i in range(1, num + 1):  # Calculate factorial using a loop
            factorial *= i

    print(f"The factorial of {num} is {factorial}")


if __name__ == "__main__":
    compute_factorial()
